{
  "openapi": "3.1.0",
  "info": {
    "title": "Chocolate Shop API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up. Does not touch the database.",
        "operationId": "live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database answers.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "JSON body of every non-2xx response.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorDetails"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "For logs and debugging. Never shown to customers as-is."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set on 5xx only, so a customer can quote it. Matches the `x-request-id` header."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable machine-readable error key. The frontend branches on it.\n\nAppend-only: once shipped, never rename or reuse a variant. Name domain codes with\n`GLOSSARY.md` terms, e.g. `box_not_full`.",
        "enum": [
          "not_found",
          "method_not_allowed",
          "payload_too_large",
          "timeout",
          "bad_request",
          "validation_failed",
          "internal"
        ]
      },
      "ErrorDetails": {
        "type": "object",
        "required": [
          "fields"
        ],
        "properties": {
          "fields": {
            "type": "object",
            "description": "Messages per invalid field, keyed by field path, e.g. `address.city`.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
