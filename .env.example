# Copy to .env for local dev. Matches infra/compose.dev.yml.
# Real env vars override .env. Only DATABASE_URL is required; the rest show their defaults.

API_ADDR=127.0.0.1:3000
DATABASE_URL=postgres://chocolate:chocolate@localhost:5432/chocolate_shop

DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5

# Requests slower than this return 503 `timeout`.
REQUEST_TIMEOUT_SECS=30
# Max JSON body size. Routes needing more (uploads) raise it themselves.
BODY_LIMIT_BYTES=1048576

# Log levels (tracing EnvFilter syntax) and output: pretty | json (use json in production).
LOG_FORMAT=pretty
RUST_LOG=info,api=debug,tower_http=debug
